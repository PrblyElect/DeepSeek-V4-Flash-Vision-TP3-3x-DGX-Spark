# deepseek-v4flash-vision TP=3 cluster env — the serving profile of record.
# Every value below is the measured optimum for THIS stack (3x DGX Spark,
# Anemll dspark-vllm-gx10 image, DSpark k=5 spec, SP-prefill stage 3);
# the measured-why comments carry the rounded verdicts from docs/FIXLOG.md.
#
# This file follows the env shape of the public 2-Spark DSpark vision recipe
# line (see README credits) — stage it as that checkout's env file and the
# compose entrypoint applies everything, including the TP3 pad kit and the
# chained SP applier, at TP_SIZE=3.
#
# EDIT the blocks marked EDIT for your site; everything else is pinned to
# the validated profile.

# --- checkpoint (EDIT: identical staging on all three boxes). Any
# --- DeepSeek-V4-Flash-Vision-Exp checkpoint in the native mixed FP4+FP8
# --- packaging works — the recipe is agnostic between the official release
# --- and abliteration derivatives of it (pick your weights; we validated
# --- with an abliteration derivative of the official Vision-Exp checkpoint
# --- and ran the refusal/sanity probe on that build). If you serve a
# --- derivative, point DSPARK_MODEL_OFFICIAL at its repo id and revision.
DSPARK_MODEL_OFFICIAL=deepseek-ai/DeepSeek-V4-Flash-Vision-Exp
DSPARK_REVISION=86f746b36186f0e567729a5c06a8c918caba82a9
MODEL_NAME=deepseek-v4-flash-vision-exp
# Runtime ABI note: if your checkpoint is a STATIC abliteration derivative
# (weights already ablated), keep any runtime-abliteration flag at 0 —
# runtime-direction mode on pre-ablated weights double-applies.
ABLITERATED=0

# --- runtime image: the one public image of this line with a working
# --- multimodal serving class (native ViT + Aligner, 8 images/request);
# --- digest-pinned. Re-pin only after re-validating the patches against
# --- the new tree (see patches/README.md). ---
DSPARK_VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8

# --- TP=3 ring (EDIT: your three boxes). Bootstrap on the management LAN;
# --- NCCL pinned to both on-board HCAs per rank, GID 3, RoCEv2, cross-NIC.
# --- The full three-cable triangle is required — every rank talks to both
# --- peers. Boot gate: the NCCL banner + all three ranks join the ring
# --- before anything else is diagnosed.
TP_SIZE=3
NNODES=3
MASTER_ADDR=192.168.0.10
MASTER_PORT=9999
WORKER_HOST=192.168.0.11
WORKER2_HOST=192.168.0.12
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_IB_GID_INDEX=3
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CROSS_NIC=1
NCCL_DEBUG=WARN
# Channels: measured interior optimum on a 3-rank dual-HCA ring
# (4 -> 8 was ~+20% aggregate; 16 was ~-8%). Do not copy from 2-box lanes.
NCCL_MAX_NCHANNELS=8

# --- TP3 pad (the localaiguyy kit, MIT — vendored from its public repo;
# --- applied automatically by the compose entrypoint from the mounted
# --- patches dir). The operative mechanism, per the code that RUNS (the
# --- kit's own docs contradict themselves — read the applier): pad the
# --- attention o_group COUNT 8->9 (9 % 3 == 0), heads-per-group STAYS 8,
# --- total heads 64->72 (3 groups / 24 heads per rank). r stays
# --- 8x512=4096 — the fp8 einsum kernel contract forbids any scheme that
# --- changes heads-per-group. The 9th group per rank is pure pad: zero
# --- wo_a/wo_b slabs, attention sinks -inf (NEVER zero — see landmine 2).
# --- No-op at TP=1/2 by construction.
VLLM_DSV4_TP_PAD=1
TP3_PATCH_DIR=./tp3

# --- SP prefill (this repo's patches/apply_sp_prefill.py, chained after
# --- the pad kit — see patches/README.md). Stage 3 = sharded inter-layer
# --- state + local attention front. MIN_ROWS above the decode ceiling
# --- (32 seqs x (k+1) = 192): decode forwards never take the SP path, and
# --- in mixed serving the scheduler's 1024-token prefill steps stay stock
# --- by design — SP engages on solo deep prefills run as full ~8K chunks
# --- (the adaptive-chunk flag below). Threshold/MIN_ROWS alternatives
# --- were measured and rejected (FIXLOG).
DSV4V_PREFILL_SP_STAGES=3
DSV4V_PREFILL_SP_MIN_ROWS=4097

# --- offline cache hygiene: serve cache-only, no Hub traffic. The repo
# --- ships no preprocessor_config.json — the image's vision hotfix injects
# --- the processor in code; offline lookups return None gracefully.
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
HF_HUB_OFFLINE=1
# (EDIT if you stage the snapshot elsewhere) the in-checkpoint DSpark
# encoding file, from the OFFICIAL snapshot's path:
DSPARK_ENCODING_FILE=/cache/huggingface/hub/models--deepseek-ai--DeepSeek-V4-Flash-Vision-Exp/snapshots/86f746b36186f0e567729a5c06a8c918caba82a9/encoding/encoding_dsv4.py

# --- client surface (EDIT to taste) ---
PROJECT_NAME=ds4flash-vision
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
SERVED_MODEL_NAME=ds4flash-vision
DEFAULT_THINKING=high

# --- deterministic boot posture (runtime, next relaunch). Honest scope:
# --- this model runs EAGER — vLLM logs "torch.compile is turned on, but
# --- the model ... does not support it" — so VLLM_FORCE_AOT_LOAD is an
# --- inert safeguard (there is no AOT artifact to load/miss) and
# --- CUDA_DEVICE_ORDER is a no-op (one GB10 per rank). Harmless; keep only
# --- as a safety latch if a future model enables torch.compile or a box
# --- gains >1 GPU. Applies at the next relaunch, not a live boot; the
# --- boot-lottery axis is kernel JIT/warmup, not this block.
VLLM_FORCE_AOT_LOAD=1
CUDA_DEVICE_ORDER=PCI_BUS_ID

# --- serving shape of record (measured; rounded verdicts in the README
# --- numbers table and docs/FIXLOG.md) ---
MAX_MODEL_LEN=1048576
# 32 seqs, capture 192 = 32 x (5+1): the aggregate shape (~1K tok/s @32-way
# count-class). seqs 16 is the interactive-friendlier variant (~720 @16
# with a lighter capture bill); seqs 6 is the TP2-proven minimum.
MAX_NUM_SEQS=32
# MNBT two-truths: 8192 on spec-decode boots. 4096 starves the draft/verify
# pipeline (~-70% single-stream); 6144 trades ~+25% pool for deep-recall
# risk (chunk-path interaction — only safe WITH the sparse-MLA chunk
# hotfix, which is the long-document variant); 16384 burns ~40% of the
# pool for nothing.
MAX_NUM_BATCHED_TOKENS=8192
# Long-prefill chunk threshold: 1024 is the measured optimum for MIXED
# serving (2048 and MIN_ROWS-lowering both measured worse — FIXLOG). With
# adaptive chunk ON (below) a SOLO deep prefill runs full ~8K chunks —
# which is what engages the SP path.
LONG_PREFILL_TOKEN_THRESHOLD=1024
DSPARK_MAX_INFLIGHT_PREFILLS=2
MTP_NUM_TOKENS=5
DSPARK_ENABLE_DSPARK_BLOCK_K=1
DSPARK_ENABLE_DSPARK_SWA_PREFIX=1
DSPARK_ENABLE_ISSUE136_XGRAMMAR_HOTFIX=1
# Adaptive chunk: KEEP — measured double-digit solo-deep-prefill gains
# (13-22% at depth on the four-arm ladder) and the SP-engagement switch.
# Mixed-load behavior is unchanged by the hotfix's own contract (the 1024
# cap returns whenever a decode is active — the fairness trade).
DSPARK_ENABLE_ADAPTIVE_CHUNK=1
# Prefill-decode deferral cadence (patches/apply_prefill_decode_interval.py,
# applied after the adaptive-chunk and issue-43 hotfixes in the checkout's
# entrypoint chain — see patches/README.md). While decode is active — or
# was scheduled within N+2 steps — hold the chunk threshold against the
# adaptive lift and run >= N decode-favorable steps between prefill
# chunks. Closes the two mixed-load holes the adaptive-chunk contract
# leaves open: the cap-return presence check races with momentary decode
# absence (async scheduling + spec-decode draft phases), and any
# chunk-carrying step still costs its full wall time. Measured, same
# night both arms, idle-gated: decode beside a ~440K prefill drops from
# ~12x TPOT inflation with multi-second freezes to ~3x with worst gaps
# in the ~1 s class (4-stream: ~6x -> ~2x per stream, median back at
# solo speed); mixed prefill itself IMPROVES (~14% -> ~7-9% under
# solo); solo paths and outputs are untouched (temp-0 byte-identical).
# N=2 is the serving point; 0/unset = the patch is not applied at all.
DSPARK_PREFILL_DECODE_INTERVAL=2
# Pure caches — the only speed/memory levers that never touched the
# chunk/indexer/KV path on this stack (fail-closed pair: apply together):
# fp4 indexer cache (+pool record territory) and the DeepGEMM alias;
# plus the C128A prefill cache (~+30% prefill, the one prefill lever
# that moved).
DSPARK_ENABLE_MXFP4_INDEXER_CACHE=1
DSPARK_ENABLE_DEEPGEMM_SM121_ALIAS=1
DSPARK_ENABLE_C128A_PREFILL_CACHE=1

# --- memory: the working-man posture. gmu ladder (measured): 0.76 ~3.8M
# --- pool -> 0.77 ~3.9M -> 0.80 ~4.3M ADOPTED once the GPU side-tenant
# --- class was retired (the earlier 0.80 rejection was a co-tenant-era
#   floor verdict). GB10 is unified memory: co-tenants and page cache
# --- count against the startup check; drop caches on every rank before
# --- boot, and set gmu by the box with the most neighbors (the pool is
# --- the min across ranks). Two measured truths worth keeping: (1) gmu is
# --- quality-neutral by construction — it sizes the KV pool only;
# --- (2) after an OOM-kill storm with driver errors on a rank, that
# --- rank's usable headroom stays degraded (allocator residue that no
# --- container recreate or cache drop clears) until the box is rebooted —
# --- budget a cool-window reboot after any such storm before trusting
# --- pool numbers again.
GPU_MEMORY_UTILIZATION_TEXT=0.80
